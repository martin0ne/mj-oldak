---
// Think-tank (v4, 12.10.2026) — teaser green punk BEZ szczegółów (brief Marcina).
// Styl: serif + hairline + mono kicker, zero AI-slop.
---
<section id="thinktank" class="relative overflow-hidden bg-background dark:bg-[var(--c-page)] text-dark dark:text-[var(--c-ink)] px-8 md:px-16 py-24 md:py-32 border-t border-current/10 transition-colors duration-500">
  <div class="max-w-5xl mx-auto relative z-10">
    <p class="font-mono text-xs uppercase tracking-[0.24em] opacity-50 mb-6">
      <span class="text-sunset">—</span> 08 · Think-tank
    </p>

    <h2 class="font-serif text-4xl md:text-5xl leading-[1.02] tracking-[-0.01em] mb-8">
      Green punk — <em class="italic">projekt zamknięty</em>.
    </h2>

    <p class="font-serif italic text-xl md:text-2xl leading-snug max-w-3xl mb-6 opacity-90">
      Prowadzimy zamknięty projekt badawczy o energii, projektowaniu i życiu
      zgodnym z naturą. Bez szczegółów na tym etapie.
    </p>

    <div class="max-w-3xl mb-14">
      <div class="flex items-baseline justify-between gap-4 py-4 border-t border-current/15">
        <span class="font-sans text-base font-medium">Etap</span>
        <span class="font-sans text-base opacity-70 text-right">badania w toku · dane zbierane w 2026</span>
      </div>
      <div class="flex items-baseline justify-between gap-4 py-4 border-t border-current/15">
        <span class="font-sans text-base font-medium">Dostęp</span>
        <span class="font-sans text-base opacity-70 text-right">pierwsze analizy pojawią się tutaj i na blogu po domknięciu</span>
      </div>
      <div class="flex items-baseline justify-between gap-4 py-4 border-t border-b border-current/15">
        <span class="font-sans text-base font-medium">Zasada</span>
        <span class="font-sans text-base opacity-70 text-right">publikujemy wynik, nie domysły — zawsze ze źródłem i datą</span>
      </div>
    </div>

    <a href="#contact" class="inline-block px-6 py-3 rounded-[6px] border border-current/35 text-sm font-medium hover:border-current transition-colors duration-200 no-underline">
      Napisz, jeśli budujesz coś podobnego
    </a>
  </div>
</section>
