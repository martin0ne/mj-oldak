---
// Sekcja scalona: Narzędzia + Stack — jedna zwarta sekcja v1 (14.10.2026)
// Mono kicker, krótki serif lead, karty live-demo,
// tabela P/S/E skompaktowana do wierszy mono z linią włosową,
// stack na końcu jako zwarty blok kolumnowy.
const teasers = [
  { id: 'agent', num: '01', title: 'Agent Mission Control', note: 'agent planuje, wywołuje narzędzia, wraca po błędach' },
  { id: 'ocr', num: '02', title: 'OCR Invoice Reader', note: 'PDF lub zdjęcie → ustrukturyzowane dane faktury' },
  { id: 'email', num: '03', title: 'Pomocnik maili', note: 'klasyfikacja 4 kategorii + szkice odpowiedzi' },
  { id: 'reporting', num: '04', title: 'Reporting Agent', note: 'eksporty z księgi → raport PDF z KPiR' },
];

const groups = [
  {
    num: '01',
    title: 'Agentic AI & LLMs',
    items: [
      { t: 'Claude (API + Claude Code)', d: 'Mówisz, a on pisze kod i odpowiada na pytania. Pracuje ze mną codziennie, najczęściej ze wszystkich.' },
      { t: 'Gemini', d: 'Drugi duży język — drugi wzrok. Przydatny, gdy trzeba spojrzeć na to samo z innej strony.' },
      { t: 'Hermes Agent', d: 'Mój osobisty robot: sam wykonuje zlecone zadania, pilnuje terminów i woła mnie tylko wtedy, gdy naprawdę trzeba.' },
      { t: 'Autonomous agents', d: 'Program, który nie czeka na każde polecenie — sam planuje, działa i poprawia swoje błędy.' },
      { t: 'MCP (Model Context Protocol)', d: 'Wtyczka, która pozwala jednym programom wołać drugie, jak człowiek podaje koledze narzędzie.' },
      { t: 'Prompt engineering', d: 'Sztuka mówienia do maszyny tak, żeby zrozumiała za pierwszym razem — jak do kucharza: precyzyjnie, a nie „zrób coś dobrego”.' },
      { t: 'Multi-LLM routing', d: 'Centrala, która rozdziela pytania do właściwego modelu — jak przenośnia na dworcu: jedna kolejka, wiele pociągów.' },
    ],
  },
  {
    num: '02',
    title: 'Workflow orchestration',
    items: [
      { t: 'n8n', d: 'Kłębki przewodów w fabryce: jedno się wydarza, drugie dzieje się samo. Kiedyś robione ręcznie, teraz bez rąk.' },
      { t: 'Firecrawl', d: 'Zdejmuje tekst ze stron internetowych tak jak kiedyś przepisywało się z księgi — żeby maszyna mogła to przeczytać.' },
      { t: 'Make.com', d: 'Młodszy brat n8n — ta sama robota, w innej obudowie.' },
      { t: 'Google Apps Script', d: 'Skrypty w arkuszach: automatyka tam, gdzie firma i tak już mieszka, czyli w tabeli.' },
      { t: 'REST APIs & webhooks', d: 'Poczta między programami: jeden kiwa głową, drugi dostaje wiadomość i działa.' },
      { t: 'Cloudflare Workers', d: 'Małe półautomaty rozstawione w internecie, które odpalają się o wyznaczonej godzinie, nawet gdy mój komputer śpi.' },
      { t: 'Nowoczesna alternatywa dla RPA', d: 'Tańsza i mniej krucha metoda zastępowania nudnej roboty niż stare automaty do klikania w ekran.' },
    ],
  },
  {
    num: '03',
    title: 'RAG & knowledge bases',
    items: [
      { t: 'RAG w produktach', d: 'Maszyna nie zgaduje — najpierw zagląda do Twoich papierów, potem odpowiada z powołaniem.' },
      { t: 'Projektowanie bazy wiedzy', d: 'Układanie szuflad z wiedzą tak, żeby dało się w nich znaleźć, zanim cokolwiek zapytasz.' },
      { t: 'Zettelkasten (vault)', d: 'Szuflada z karteczkami, tylko lepiej uporządkowana niż twoja szuflada — i nie gubi karteczek.' },
      { t: 'Monitoring ekosystemu AI', d: 'Czytnik prasy branżowej: co dzień sprawdzam, czy w świecie AI nie wydarzyło się coś, co mnie dotyczy.' },
    ],
  },
  {
    num: '04',
    title: 'Discovery & business analysis',
    items: [
      { t: 'Mom Test discovery', d: 'Pytaj ludzi o ich życie, nie o to, czy kupią — bo kupią z grzeczności, a potem nie kupią.' },
      { t: 'BPMN 2.0', d: 'Rysowanie procesu zanim się go zmieni — jak plan piętra przed remontem.' },
      { t: 'User stories (Given/When/Then)', d: 'Opis wymagania tak prosty, że da się je sprawdzić: kiedy coś się dzieje, ma wyjść to, co uzgodniliśmy.' },
      { t: 'PRD i liczenie ROI', d: 'Zanim cokolwiek zbuduję — liczę, czy ma sens i czy zwróci się szybciej, niż zdążę się znudzić.' },
      { t: 'Compose przed build', d: 'Zanim coś zbuduję, szukam, czy gotowe nie leży na półce. Budować wolno tylko wtedy, gdy gotowe naprawdę nie pasuje.' },
    ],
  },
  {
    num: '05',
    title: 'Ethical AI & compliance',
    items: [
      { t: 'RODO Art. 22 / 28', d: 'Prawo, że w ważnej sprawie nie decyduje za ciebie automat — i że dane są twoje, nie cudze.' },
      { t: 'Człowiek w pętli', d: 'Maszyna proponuje, człowiek decyduje — od początku zaprojektowane, nie doklejone na końcu.' },
      { t: 'Dane w UE', d: 'Twoje dane śpią w Europie, nie za oceanem — łatwiej je odzyskać i pilnować.' },
      { t: 'Prywatność z fabryki', d: 'Zamknięte drzwi od początku, nie kłódka dokupiona później.' },
    ],
  },
  {
    num: '06',
    title: 'Programming (AI-assisted)',
    items: [
      { t: 'Python i FastAPI', d: 'Język, w którym pisze się szybko, i serwer, który odpowiada, zanim zdążysz się zniecierpliwić.' },
      { t: 'SQL, Supabase (RLS)', d: 'Tabela z prawami: każdy widzi tylko swoje wiersze, nawet jeśli ktoś się pomyli.' },
      { t: 'Azure Document Intelligence', d: 'Czytnik faktur — z fotografii wyciąga liczby lepiej niż człowiek po ósmej godzinie pracy.' },
      { t: 'Astro, Cloudflare Pages + D1', d: 'Silnik tej strony: szybki i statyczny, bez ciężkiego serwera — stoi na krawędzi internetu.' },
      { t: 'Playwright', d: 'Robot, który klika w stronę dokładnie jak człowiek, żeby sprawdzić, czy nic nie pękło.' },
    ],
  },
  {
    num: '07',
    title: 'Data analysis & pipelines',
    items: [
      { t: 'SQL (JOIN, okna, uzgodnienia)', d: 'Łączenie tabel i liczenie po kolei — cyfry muszą się zgadzać do ostatniego grosza.' },
      { t: 'DuckDB, pandas', d: 'Liczarka, która przełknie milion wierszy, zanim skończysz kawę.' },
      { t: 'pandera (kontrakty danych)', d: 'Strażnik przy wejściu do tabeli: zły numer nie przechodzi dalej.' },
      { t: 'DVC (odtwarzalne pipeline)', d: 'Pamięć robota: co zmieniło się kiedy i dlaczego — nic nie ginie bez śladu.' },
      { t: 'Proweniencja danych (SHA-256)', d: 'Pieczęć na każdym pliku: jeśli ktoś coś podmieni, odcisk to pokaże.' },
      { t: 'Dane publiczne (GUS · Eurostat · NBP · ECB)', d: 'Liczby z urzędów: wolne, oficjalne i z datą. Z nimi się nie dyskutuje — cytuje się je.' },
    ],
  },
];

---

<section id="work" class="relative overflow-hidden bg-[#fafafa] dark:bg-[var(--c-page)] text-dark dark:text-[var(--c-ink)] px-8 md:px-16 py-24 md:py-32 transition-colors duration-500">
  <div class="max-w-5xl mx-auto relative z-10">
    <!-- Kicker -->
    <p class="font-mono text-xs uppercase tracking-[0.24em] opacity-50 mb-6">
      <span class="text-sunset">—</span> 01 · Wybrane prace
    </p>

    <!-- Heading -->
    <h2 class="font-serif text-4xl md:text-5xl leading-[1.02] tracking-[-0.01em] mb-6">
      Wybrane prace.
    </h2>

    <!-- Lead -->
    <p class="font-serif italic text-xl md:text-2xl leading-snug max-w-3xl mb-14 opacity-90">
      Eseje w redakcji, dwie analizy zbudowane na danych i kodzie, a cztery dema —
      agent, OCR, mail, raporty — mieszkają obok, na własnej podstronie.
    </p>

    <!-- Divider -->
    <hr class="border-t border-dark/10 dark:border-[var(--c-line)] w-full mb-14" />

    <!-- Wyróżnione: eseje + dwie analizy (decyzja Marcina15.10: „just eseje — nie książka") -->
    <div class="grid md:grid-cols-3 gap-4 mb-8">
      <div class="rounded-lg border border-dark/15 bg-dark text-primary p-7 flex flex-col">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-1.5 h-1.5 bg-[#edf3ec]"></span>
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#9db8a0]">Tom esejów · w redakcji</span>
        </div>
        <h3 class="font-serif text-xl mb-3 leading-snug">Trzy pierwsze eseje</h3>
        <ul class="font-sans text-sm opacity-85 leading-relaxed space-y-2 mb-5">
          <li><a href="/artykuly/wioska-i-imperium/" class="underline decoration-1 underline-offset-4 hover:opacity-70">Wioska i Imperium</a></li>
          <li><a href="/artykuly/data-zero/" class="underline decoration-1 underline-offset-4 hover:opacity-70">Data zero</a></li>
          <li><a href="/artykuly/oligarchia/" class="underline decoration-1 underline-offset-4 hover:opacity-70">Oligarchia</a></li>
        </ul>
        <p class="font-sans text-sm opacity-65 leading-relaxed mt-auto">
          Lot za 1 320 zł, dwie daty startu i władza bogactwa od Solona do Zucmana —
          pełne teksty, czytelne od razu na stronie.
        </p>
      </div>
      <a
        href="/artykuly/co-dane-mowia-o-adopcji-ai-polska-vs-ue/"
        class="group rounded-lg border border-dark/15 bg-dark text-primary p-7 hover:border-accent transition-colors duration-200 no-underline block"
      >
        <div class="flex items-center gap-2 mb-3">
          <span class="w-1.5 h-1.5 bg-[#e1f3fe]"></span>
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#8fb9d4]">Analiza danych · GUS × Eurostat</span>
        </div>
        <h3 class="font-serif text-xl mb-2 leading-snug">Adopcja AI: Polska vs UE</h3>
        <p class="font-sans text-sm opacity-80 leading-relaxed mb-5">
          Ręcznie pisany SQL uzgadnia ten sam wskaźnik między GUS a Eurostatem:
          Polska wdraża szybko, ale od niskiej bazy, więc dystans do UE rośnie.
          Z liczbami, źródłami i datami — plus raport do pobrania.
        </p>
        <span class="font-mono text-xs uppercase tracking-[0.12em] text-accent group-hover:underline">
          analiza + raport (PDF) ↗
        </span>
      </a>
      <a
        href="/artykuly/bm25-vs-embeddingi-lawka-pomiarowa/"
        class="group rounded-lg border border-dark/15 bg-dark text-primary p-7 hover:border-accent transition-colors duration-200 no-underline block"
      >
        <div class="flex items-center gap-2 mb-3">
          <span class="w-1.5 h-1.5 bg-[#fdebec]"></span>
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#c98a88]">Eksperyment · ławka pomiarowa</span>
        </div>
        <h3 class="font-serif text-xl mb-2 leading-snug">BM25 kontra embeddingi</h3>
        <p class="font-sans text-sm opacity-80 leading-relaxed mb-5">
          Czy semantyka zawsze wygrywa ze słowami? Zbudowana ławka pomiarowa
          pokazuje czarno na białym, że nie — i w którym momencie wyszukiwanie
          po znaczeniu pada.
        </p>
        <span class="font-mono text-xs uppercase tracking-[0.12em] text-accent group-hover:underline">
          czytaj analizę ↗
        </span>
      </a>
    </div>

    <!-- Na żywo: infrastruktura (komprakt zamiast kart) -->
    <div class="mb-14 border border-dark/15 rounded-lg p-5 bg-white">
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] opacity-55 mb-3">Na żywo</p>
      <div class="grid sm:grid-cols-2 gap-x-8 gap-y-2 font-sans text-sm">
        <p><a href="https://demo.mjoldak.pl" target="_blank" rel="noopener" class="font-semibold underline decoration-1 underline-offset-4 hover:opacity-70">Sales Agent B2B</a> —
          <span class="opacity-70">formularz → klasyfikacja leadów GenAI, baza w UE, człowiek w pętli</span></p>
        <p><span class="font-semibold">Pipeline n8n (MCP)</span> —
          <span class="opacity-70">Webhook → Gemini → baza w UE, wywoływalny przez agentów jak narzędzie</span></p>
      </div>
    </div>

    <!-- Teaser dem: jedna linijka na demo, szczegóły na /demy/ -->
    <div class="mb-14">
      <h3 class="font-mono text-xs uppercase tracking-[0.18em] opacity-50 mb-5">Demy — szczegóły na podstronie</h3>
      <div class="border-t border-dark/10 dark:border-[var(--c-line)]">
        {teasers.map((d) => (
          <a
            href={`/demy/#${d.id}`}
            class="grid grid-cols-[36px_1fr] sm:grid-cols-[36px_220px_1fr] gap-x-4 gap-y-1 items-baseline py-3.5 border-b border-dark/10 dark:border-[var(--c-line)] no-underline hover:bg-dark/[0.02] transition-colors duration-200 group"
          >
            <span class="font-mono text-[10px] tracking-[0.2em] opacity-50">{d.num}</span>
            <span class="font-sans font-semibold text-[15px] text-dark dark:text-[var(--c-ink)] group-hover:underline">{d.title}</span>
            <span class="font-sans text-sm opacity-65 col-span-2 sm:col-span-1">{d.note} →</span>
          </a>
        ))}
      </div>
      <p class="font-mono text-xs uppercase tracking-[0.12em] mt-5">
        <a href="/demy/" class="text-accent hover:underline no-underline">Wszystkie dema (4) ↗</a>
      </p>
    </div>

    <!-- Divider -->
    <hr class="border-t border-dark/10 dark:border-[var(--c-line)] w-full my-14" />

    <!-- Kod otwarty — wtopione z osobnej sekcji (brief 15.10: repo = część projektów) -->
    <hr class="border-t border-dark/10 dark:border-[var(--c-line)] w-full mb-14" />
    <h3 class="font-mono text-xs uppercase tracking-[0.18em] opacity-50 mb-5">Kod otwarty — 6 repo</h3>
    <p class="font-sans text-base opacity-80 leading-relaxed mb-5 max-w-3xl">
      Nie wierz mi na słowo — czytaj kod: agenci, narzędzia wielokrotnego użytku
      i odtwarzalna analityka w sześciu publicznych repozytoriach.
    </p>
    <a href="https://github.com/martin0ne" target="_blank" rel="noopener"
       class="font-mono text-xs uppercase tracking-[0.12em] text-accent hover:underline no-underline">
      github.com/martin0ne ↗
    </a>

    <!-- Stack: zwarty blok kolumnowy -->
    <div>
      <h3 class="font-mono text-xs uppercase tracking-[0.18em] opacity-50 mb-5">Stack</h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {groups.map((g) => (
          <div class="rounded-lg border border-dark/10 dark:border-[var(--c-line)] bg-dark/[0.015] p-5 hover:border-accent/40 transition-colors duration-300">
            <div class="font-mono text-[10px] tracking-[0.2em] text-accent mb-2">{g.num}</div>
            <h4 class="font-sans font-bold text-base mb-3 tracking-tight">{g.title}</h4>
            <ul class="space-y-1.5">
              {g.items.map((item) => (
                <li class="font-sans text-sm leading-relaxed">
                  <button
                    type="button"
                    class="js-card w-full text-left flex gap-2.5 items-baseline opacity-75 hover:opacity-100 hover:underline underline-offset-2 transition-opacity duration-200 bg-transparent border-0 p-0 cursor-pointer font-sans text-sm leading-relaxed"
                    data-card
                    data-rank={g.num}
                    data-title={item.t}
                    data-desc={item.d}
                    title={item.d}
                  >
                    <span class="text-accent shrink-0">▸</span>
                    <span>{item.t}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Karta do gry: klik w pozycję stacku pokazuje wyjaśnienie po ludzku -->
  <div
    id="stack-card-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="stack-card-title"
    class="fixed inset-0 z-[60] p-6"
    style="display:none"
    tabindex="-1"
  >
    <div class="absolute inset-0 bg-black/45" data-card-close></div>
    <div
      class="stack-card relative mx-auto my-0 sm:my-auto w-full max-w-[300px] min-h-[420px] bg-[#fbfbfa] text-[#111111] border border-[#111111] rounded-[14px] p-6 flex flex-col"
      data-card-close
    >
      <div class="flex items-start justify-between">
        <span id="stack-card-rank" class="font-mono text-lg font-bold tracking-tight">01</span>
        <span class="font-mono text-lg font-bold tracking-tight rotate-180" aria-hidden="true"><span id="stack-card-rank-mirror">01</span></span>
      </div>
      <div class="flex-1 flex flex-col justify-center text-center py-6">
        <div class="w-10 h-px bg-[#111111] mx-auto mb-5 opacity-40"></div>
        <h4 id="stack-card-title" class="font-serif text-2xl leading-snug mb-4">—</h4>
        <p id="stack-card-body" class="font-sans text-[15px] leading-relaxed opacity-85">—</p>
        <div class="w-10 h-px bg-[#111111] mx-auto mt-5 opacity-40"></div>
      </div>
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-center opacity-50">kliknij, aby zamknąć</p>
    </div>
  </div>
</section>

<script>
  const overlay = document.getElementById('stack-card-overlay');
  const titleEl = document.getElementById('stack-card-title');
  const bodyEl = document.getElementById('stack-card-body');
  const rankEl = document.getElementById('stack-card-rank');
  const rankMirror = document.getElementById('stack-card-rank-mirror');
  let lastFocus = null;

  function openCard(btn) {
    lastFocus = btn;
    rankEl.textContent = btn.dataset.rank || '';
    rankMirror.textContent = btn.dataset.rank || '';
    titleEl.textContent = btn.dataset.title || '';
    bodyEl.textContent = btn.dataset.desc || '';
    overlay.style.display = 'block';
    overlay.focus();
  }
  function closeCard() {
    overlay.style.display = 'none';
    if (lastFocus) lastFocus.focus();
  }

  document.querySelectorAll('.js-card').forEach((btn) => {
    btn.addEventListener('click', () => openCard(btn));
  });
  overlay.addEventListener('click', (e) => {
    if (e.target.closest('[data-card-close]')) closeCard();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.style.display === 'block') closeCard();
  });
</script>

<style>
  .stack-card { animation: card-pop 0.18s ease-out; }
  @keyframes card-pop {
    from { opacity: 0; transform: translateY(6px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stack-card { animation: none; }
  }
</style>
