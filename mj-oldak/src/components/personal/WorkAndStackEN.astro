    <hr class="border-t border-dark/10 dark:border-[var(--c-line)] w-full my-14" />

    <!-- Stack: compact columnar blocks -->
    <div>
      <h3 class="font-mono text-xs uppercase tracking-[0.18em] opacity-50 mb-5">Stack</h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {groups.map((g) => (
          <div class="rounded-lg border border-dark/10 dark:border-[var(--c-line)] bg-dark/[0.015] p-5 hover:border-accent/40 transition-colors duration-300">
            <div class="font-mono text-[10px] tracking-[0.2em] text-accent mb-2">{g.num}</div>
            <h4 class="font-sans font-bold text-base mb-3 tracking-tight">{g.title}</h4>
            <ul class="space-y-1.5">
              {g.items.map((item) => (
                <li class="font-sans text-sm leading-relaxed">
                  <button
                    type="button"
                    class="js-card w-full text-left flex gap-2.5 items-baseline opacity-75 hover:opacity-100 hover:underline underline-offset-2 transition-opacity duration-200 bg-transparent border-0 p-0 cursor-pointer font-sans text-sm leading-relaxed"
                    data-card
                    data-rank={g.num}
                    data-title={item.t}
                    data-desc={item.d}
                    title={item.d}
                  >
                    <span class="text-accent shrink-0">▸</span>
                    <span>{item.t}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Play card overlay: click a stack item to see plain-language explanation -->
  <div
    id="stack-card-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="stack-card-title"
    class="fixed inset-0 z-[60] p-6"
    style="display:none"
    tabindex="-1"
  >
    <div class="absolute inset-0 bg-black/45" data-card-close></div>
    <div
      class="stack-card relative mx-auto my-0 sm:my-auto w-full max-w-[300px] min-h-[420px] bg-[#fbfbfa] text-[#111111] border border-[#111111] rounded-[14px] p-6 flex flex-col"
      data-card-close
    >
      <div class="flex items-start justify-between">
        <span id="stack-card-rank" class="font-mono text-lg font-bold tracking-tight">01</span>
        <span class="font-mono text-lg font-bold tracking-tight rotate-180" aria-hidden="true"><span id="stack-card-rank-mirror">01</span></span>
      </div>
      <div class="flex-1 flex flex-col justify-center text-center py-6">
        <div class="w-10 h-px bg-[#111111] mx-auto mb-5 opacity-40"></div>
        <h4 id="stack-card-title" class="font-serif text-2xl leading-snug mb-4">—</h4>
        <p id="stack-card-body" class="font-sans text-[15px] leading-relaxed opacity-85">—</p>
        <div class="w-10 h-px bg-[#111111] mx-auto mt-5 opacity-40"></div>
      </div>
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-center opacity-50">click to close</p>
    </div>
  </div>
</section>

<script>
  const overlay = document.getElementById('stack-card-overlay');
  const titleEl = document.getElementById('stack-card-title');
  const bodyEl = document.getElementById('stack-card-body');
  const rankEl = document.getElementById('stack-card-rank');
  const rankMirror = document.getElementById('stack-card-rank-mirror');
  let lastFocus = null;

  function openCard(btn) {
    lastFocus = btn;
    rankEl.textContent = btn.dataset.rank || '';
    rankMirror.textContent = btn.dataset.rank || '';
    titleEl.textContent = btn.dataset.title || '';
    bodyEl.textContent = btn.dataset.desc || '';
    overlay.style.display = 'block';
    overlay.focus();
  }
  function closeCard() {
    overlay.style.display = 'none';
    if (lastFocus) lastFocus.focus();
  }

  document.querySelectorAll('.js-card').forEach((btn) => {
    btn.addEventListener('click', () => openCard(btn));
  });
  overlay.addEventListener('click', (e) => {
    if (e.target.closest('[data-card-close]')) closeCard();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.style.display === 'block') closeCard();
  });
</script>

<style>
  .stack-card { animation: card-pop 0.18s ease-out; }
  @keyframes card-pop {
    from { opacity: 0; transform: translateY(6px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stack-card { animation: none; }
  }
</style>
