---
// Dolny TICKER — fixed pasek (B/W, 14.10.2026).
// Marquee w czystym CSS; pauza na hover; prefers-reduced-motion = statyczna lista.
// Rezerwa padding-bottom na stronie przez [data-ticker-height].
// Pobiera te same feedy co News.astro (single source of truth: FEEDS).

const FEEDS = [
  { name: 'Ars Technica', url: 'https://feeds.arstechnica.com/arstechnica/index' },
  { name: 'Hacker News (Hnrss)', url: 'https://hnrss.org/frontpage' },
  { name: 'The Verge', url: 'https://www.theverge.com/rss/index.xml' },
  { name: 'TechCrunch', url: 'https://techcrunch.com/feed/' },
];

const parseFeed = async (feed: { name: string; url: string }): Promise<{
  title: string;
  link: string;
  pubDate: string;
  source: string;
}[]> => {
  try {
    const res = await fetch(feed.url, {
      headers: { Accept: 'application/xml, application/rss+xml, text/xml' },
    });
    if (!res.ok) return [];
    const xml = await res.text();

    // Atom
    const atomEntries = [...xml.matchAll(/<entry[^>]*>([\s\S]*?)<\/entry>/g)];
    if (atomEntries.length > 0) {
      return atomEntries.map(([, block]) => {
        const title = (block.match(/<title[^>]*>([\s\S]*?)<\/title>/m)?.[1] ?? '').trim();
        const link = block.match(/<link[^>]*href="([^"]*)"/)?.[1] ?? '#';
        const dateStr =
          (block.match(/<updated[^>]*>([\s\S]*?)<\/update>/m)?.[1] ??
          (block.match(/<published[^>]*>([\s\S]*?)<\/published>/m)?.[1] ?? ''))
            .trim();
        return title ? { title, link, pubDate: dateStr, source: feed.name } : null;
      }).filter(Boolean);
    }

    // RSS 2.0
    const items = [...xml.matchAll(/<item[\s>](.*?)<\/item>/gs)];
    return items.map(([, block]) => {
      const title = (block.match(/<title[^>]*>([\s\S]*?)<\/title>/m)?.[1] ?? '').trim();
      const link = (block.match(/<link[^>]*>([\s\S]*?)<\/link>/m)?.[1] ?? '#').trim();
      const dateStr = (block.match(/<pubDate[^>]*>([\s\S]*?)<\/pubDate>/m)?.[1] ?? '').trim();
      return title ? { title, link, pubDate: dateStr, source: feed.name } : null;
    }).filter(Boolean);
  } catch {
    return [];
  }
};

const allItems = (await Promise.all(FEEDS.map(parseFeed))).flat().sort((a, b) => {
  if (!a.pubDate && !b.pubDate) return 0;
  if (!a.pubDate) return 1;
  if (!b.pubDate) return -1;
  return new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime();
});

const tickerItems = allItems.slice(0, 8);
---

{tickerItems.length > 0 && (
  <>
    <div data-ticker-height class="h-[var(--ticker-h, 40px)]"></div>

    <nav
      aria-label="Latest headlines ticker"
      style={`--ticker-h: 40px; --marquee-speed: 45s;`}
      class="fixed bottom-0 left-0 right-0 z-50 h-[var(--ticker-h, 40px)] bg-dark dark:bg-[var(--c-page)] text-white dark:text-[var(--c-ink)] border-t border-white/10 dark:border-current/10 flex items-center overflow-hidden transition-colors duration-500"
    >
      {/* Label */}
      <span class="shrink-0 font-mono text-[10px] uppercase tracking-[0.2em] opacity-50 px-4 md:px-6 py-1 border-r border-white/10 dark:border-current/10">
        news
      </span>

      {/* Marquee track — czysty CSS, zawartość powtórzona w HTML dla seamless pętli */}
      <div class="flex-1 overflow-hidden relative h-full flex items-center mask-shim">
        <ol class="ticker-scroll inline-flex whitespace-nowrap animate-marquee hover:[animation-play-state:paused]">
          {tickerItems.map((item) => (
            <li class="inline-flex items-center gap-2 pr-6 md:pr-8">
              <span class="w-[3px] h-[3px] rounded-full bg-white/60 dark:bg-current shrink-0"></span>
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-xs leading-none no-underline hover:opacity-70 transition-opacity max-w-md truncate"
              >
                {item.title}
              </a>
            </li>
          ))}
          {/* Klon dla płynnej pętli — konieczne do CSS-only infinite marquee bez JS */}
          {tickerItems.map((item) => (
            <li class="inline-flex items-center gap-2 pr-6 md:pr-8">
              <span class="w-[3px] h-[3px] rounded-full bg-white/60 dark:bg-current shrink-0"></span>
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-xs leading-none no-underline hover:opacity-70 transition-opacity max-w-md truncate"
              >
                {item.title}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>

    <style>
      {`
        /* ===== MARQUEE — infinite scroll ===== */
        @keyframes marquee {
          0%   { transform: translateX(0); }
          100% { transform: translateX(-50%); }
        }

        .animate-marquee {
          animation: marquee var(--marquee-speed, 45s) linear infinite;
          /* duplikuj treść dla płynnego pętlowania: Astro renderuje tylko raz,
             więc duplikujemy ręcznie w HTML-u (patrz niżej) */
        }

        /* Opóźniony start po załadowaniu strony */
        .mask-shim {
          mask-image: linear-gradient(to right, transparent, black 2%, black 98%, transparent);
          -webkit-mask-image: linear-gradient(to right, transparent, black 2%, black 98%, transparent);
        }

        /* ===== REDUCED MOTION: statyczna lista ===== */
        @media (prefers-reduced-motion: reduce) {
          .animate-marquee {
            animation: none;
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem 1rem;
            padding: 0.5rem 1rem;
          }

          .animate-marquee li {
            white-space: normal;
          }

          /* ukryj etykiety i separator przy reduced motion */
          .animate-marquee li:first-child::before {
            display: none;
          }
        }

        /* ===== Duplikacja treści marquee dla pętli ===== */
        /* Kluczowe: CSS marquee wymaga podwojonego contentu — drugie klonowanie
           następuje w HTML poniżej (klon <ol>). Astro-renderowane elementy
           są kopiowane w templacie. */
      `}
    </style>
  </>
)}
