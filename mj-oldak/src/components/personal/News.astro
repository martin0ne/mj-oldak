---
// Warstwa NEWS — editorial lista (B/W, 14.10.2026).
// Pobiera nagłówki na etapie builda z RSS/Atom; nie karty, wiersze prostą listą.
// Fonty: data → Geist Mono, tytuł → Newsreader, meta → Geist Sans.
// Bez JS, zero emoji, sentence case.

// === FEEDY — zmień URL-e wg potrzeb Marcina ===
const FEEDS = [
  { name: 'Ars Technica', url: 'https://feeds.arstechnica.com/arstechnica/index' },
  { name: 'Hacker News (Hnrss)', url: 'https://hnrss.org/frontpage' },
  { name: 'The Verge', url: 'https://www.theverge.com/rss/index.xml' },
  { name: 'TechCrunch', url: 'https://techcrunch.com/feed/' },
];


// Czyszczenie tytułów z CDATA i encji HTML (RSS je przynosi)
const decodeEntities = (s: string): string =>
  s
    .replace(/&#x([0-9a-fA-F]+);/g, (_, h) => String.fromCodePoint(parseInt(h, 16)))
    .replace(/&#(\d+);/g, (_, d) => String.fromCodePoint(parseInt(d, 10)))
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&nbsp;/g, ' ');
const clean = (s: string): string =>
  decodeEntities(String(s ?? '').replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, '$1')).trim();

// Prosta parsarka XML RSS/Atom → [{title, link, pubDate}]
const parseFeed = async (feed: { name: string; url: string }): Promise<{
  title: string;
  link: string;
  pubDate: string;
  source: string;
}[]> => {
  try {
    const res = await fetch(feed.url, {
      headers: { Accept: 'application/xml, application/rss+xml, text/xml' },
    });
    if (!res.ok) return [];
    const xml = await res.text();

    // Atom: <entry>…</entry> z <title>, <link href=>, <published lub updated>
    const atomEntries = [...xml.matchAll(/<entry[^>]*>([\s\S]*?)<\/entry>/g)];
    if (atomEntries.length > 0) {
      return atomEntries.map(([, block]) => {
        const title = (block.match(/<title[^>]*>([\s\S]*?)<\/title>/m)?.[1] ?? '').trim();
        const link = block.match(/<link[^>]*href="([^"]*)"/)?.[1] ?? '#';
        const dateStr =
          (block.match(/<updated[^>]*>([\s\S]*?)<\/update>/m)?.[1] ??
          (block.match(/<published[^>]*>([\s\S]*?)<\/published>/m)?.[1] ?? ''))
            .trim();
        return clean(title) ? { title: clean(title), link: clean(link), pubDate: dateStr, source: feed.name } : null;
      }).filter(Boolean);
    }

    // RSS 2.0: <item>…</item> z <title>, <link>, <pubDate>
    const items = [...xml.matchAll(/<item[\s>](.*?)<\/item>/gs)];
    return items.map(([, block]) => {
      const title = (block.match(/<title[^>]*>([\s\S]*?)<\/title>/m)?.[1] ?? '').trim();
      const link = (block.match(/<link[^>]*>([\s\S]*?)<\/link>/m)?.[1] ?? '#').trim();
      const dateStr = (block.match(/<pubDate[^>]*>([\s\S]*?)<\/pubDate>/m)?.[1] ?? '').trim();
      return clean(title) ? { title: clean(title), link: clean(link), pubDate: dateStr, source: feed.name } : null;
    }).filter(Boolean);
  } catch {
    return [];
  }
};

const allItems = (await Promise.all(FEEDS.map(parseFeed))).flat();

// Sort descending po dacie (brana z raw ISO/string, fallback do starego)
allItems.sort((a, b) => {
  if (!a.pubDate && !b.pubDate) return 0;
  if (!a.pubDate) return 1;
  if (!b.pubDate) return -1;
  return new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime();
});

const maxItems = 15;
const items = allItems.slice(0, maxItems);

// Format daty ISO → „14 paź 2026"
const fmtDate = (d: string): string => {
  if (!d) return '';
  try {
    return new Intl.DateTimeFormat('pl-PL', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    }).format(new Date(d));
  } catch {
    return d;
  }
};
---

<section id="news" class="py-28 md:py-36 px-6 md:px-12 bg-background dark:bg-[var(--c-page)] border-b border-current/10 transition-colors duration-500">
  <div class="max-w-4xl mx-auto">
    <p class="font-mono text-xs uppercase tracking-[0.22em] opacity-50 mb-10">
      <span class="text-sunset">—</span>&ensp;09 · news
    </p>

    {items.length > 0 ? (
      <ul class="divide-y divide-current/8">
        {items.map((item) => (
          <li class="group flex gap-4 py-4 first:pt-0 last:pb-0">
            <time datetime={item.pubDate} class="font-mono text-[11px] opacity-50 min-w-[88px] pt-[2px] shrink-0">
              {fmtDate(item.pubDate)}
            </time>
            <div class="min-w-0 flex-1">
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="font-serif text-lg leading-snug text-dark dark:text-[var(--c-ink)] group-hover:opacity-70 transition-opacity no-underline"
              >
                {item.title}
              </a>
              <span class="font-sans text-xs opacity-40 mt-1 block">{item.source}</span>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="font-serif text-base opacity-40 italic">
        Brak danych — sprawdź feedy w sekcji FEEDS (News.astro).
      </p>
    )}
  </div>
</section>
