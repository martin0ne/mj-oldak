---
// Community — v3 (12.10.2026): pomysły na lepsze życie + budowanie społeczności
// + zaproszenie do współpracy z profesjonalistami i entuzjastami. Wiersze, nie kartony.
const ideas = [
  {
    title: 'Growing food in a flat',
    meta: 'microgreens · day 0',
    note: 'Four trays sown today (broccoli, radish, pea, arugula). Measurements go into a public log — yield per tray, cost per kilo, what failed.',
  },
  {
    title: 'AI course for people 40+',
    meta: 'in build',
    note: 'Teaching AI to people who already use a computer but not AI — trust first, examples before rules, a red list from day one.',
  },
  {
    title: 'Learning in public',
    meta: 'blog + newsletter',
    note: 'Weekly letter: where to find information, how to search, how to think critically. One number, one source, one lesson per issue.',
  },
];
---
<section id="community" class="relative overflow-hidden bg-background dark:bg-[var(--c-page)] text-dark dark:text-[var(--c-ink)] px-8 md:px-16 py-24 md:py-32 border-t border-dark/10 dark:border-[var(--c-line)] transition-colors duration-500">
  <div class="max-w-5xl mx-auto relative z-10">
    <p class="font-mono text-xs uppercase tracking-[0.24em] opacity-50 mb-6">
      <span class="text-[#B07A4E]">—</span> 07 · Ideas &amp; community
    </p>

    <h2 class="font-serif text-4xl md:text-5xl leading-[1.02] tracking-[-0.01em] mb-5">
      Experiments for a <em class="italic">better everyday life</em>.
    </h2>
    <p class="font-sans text-base leading-relaxed opacity-70 max-w-2xl mb-12">
      Small, testable projects — grown, measured and written up in the open. If any of them works,
      the instructions go public too.
    </p>

    <div class="border-t border-dark/12 dark:border-[var(--c-line)] mb-14">
      {ideas.map((it) => (
        <div class="grid grid-cols-1 sm:grid-cols-[1fr_160px] gap-1 sm:gap-6 py-5 border-b border-dark/12 dark:border-[var(--c-line)]">
          <div>
            <span class="font-serif text-xl leading-snug block">{it.title}</span>
            <span class="font-sans text-sm leading-relaxed opacity-75 block mt-2 max-w-2xl">{it.note}</span>
          </div>
          <span class="font-mono text-[10px] uppercase tracking-[0.16em] opacity-55 sm:text-right sm:pt-2">{it.meta}</span>
        </div>
      ))}
    </div>

    <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-start">
      <div>
        <h3 class="font-serif text-2xl mb-3">Building a community around it</h3>
        <p class="font-sans text-sm leading-relaxed opacity-75 mb-5">
          People who want to learn AI without the hype, check their sources, and share what they
          build. Starts as a weekly letter — no feed, no algorithm, one issue at a time.
        </p>
        <a
          href="/newsletter/"
          class="inline-block px-5 py-2.5 rounded-[6px] bg-[#111111] text-[#FBFBFA] dark:bg-[#FBFBFA] dark:text-[#111111] text-sm font-medium hover:bg-[#333333] dark:hover:bg-white transition-colors duration-200 no-underline"
        >
          Dołącz do newslettera
        </a>
      </div>
      <div>
        <h3 class="font-serif text-2xl mb-3">Collaborate</h3>
        <p class="font-sans text-sm leading-relaxed opacity-75 mb-5">
          Looking for professionals and enthusiasts to build with — engineers, writers, teachers,
          growers, anyone who ships. Different skills, same habit: show the work.
        </p>
        <a
          href="#contact"
          class="inline-block px-5 py-2.5 rounded-[6px] border border-dark/25 dark:border-[var(--c-line)] text-sm font-medium hover:border-dark dark:hover:border-[var(--c-ink)] transition-colors duration-200 no-underline"
        >
          Get in touch
        </a>
      </div>
    </div>
  </div>
</section>