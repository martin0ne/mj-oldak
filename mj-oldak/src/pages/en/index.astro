---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavbarPersonal from '../../components/personal/NavbarPersonal.jsx';
import HeroPersonalEN from '../../components/personal/HeroPersonalEN.jsx';
import WorkAndStackEN from '../../components/personal/WorkAndStackEN.astro';
import WritingEN from '../../components/personal/WritingEN.astro';
import AboutSectionEN from '../../components/personal/AboutSectionEN.jsx';
import ContactPersonalEN from '../../components/personal/ContactPersonalEN.jsx';

const title = 'Marcin J. Ołdak — tools, analyses and texts (MJ.OLDAK)';
const description = 'AI tools, data analyses with sources, and writing. Blog, open source. Independent operator based in Warsaw, working PL/EU.';
---

<BaseLayout title={title} description={description} lang="en">
  <NavbarPersonal client:load />
  <HeroPersonalEN client:load />
  <WorkAndStackEN />
  <WritingEN />
  <AboutSectionEN client:visible />
  <ContactPersonalEN client:visible />
</BaseLayout>
